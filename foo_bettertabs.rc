    CONTROL         "Drag tabs to reorder them",IDC_DRAG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,88,281,10
    CONTROL         "Ctrl+Tab and Ctrl+Shift+Tab cycle the tabs",IDC_CTRL_TAB,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,102,281,10
    LTEXT           "Middle click:",IDC_STATIC,12,118,84,8
    COMBOBOX        IDC_MIDDLE,99,116,130,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Panels",IDC_STATIC,7,138,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,148,286,1
    CONTROL         "Create a panel only when its tab is first shown (faster startup)",IDC_LAZY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,155,281,10
    CONTROL         "Remember the active tab",IDC_REMEMBER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,169,281,10
    CONTROL         "Show only the icon on tabs that have one",IDC_ICONS_ONLY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,183,281,10
END

IDD_PAGE_AUTOHIDE DIALOGEX 0, 0, 300, 218
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
