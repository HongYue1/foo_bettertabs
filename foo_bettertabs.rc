// Better Tabs resources. Hand-written, not generated. Coordinates are dialog units.

#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

// Dialog style profile (keep every page consistent with this; see
// foobar2000-component-dev/references/preferences-pages.md):
//   sections : header + etched line, no group boxes, no bold
//   fields   : labels in a left column (84 DU, field at 99), colon after
//   rhythm   : check boxes 14 DU apart, field rows 16 DU, 12 DU before a new section header
//   hints    : plain text under the control, or beside it for one short fact; units right of
//              the field
//   columns  : one column 7..293; content indented 5
//   colours  : hex edit + swatch button that opens the colour picker

/////////////////////////////////////////////////////////////////////////////
// Configure: modal, per container. The strip, the area the pages are placed in (IDC_PAGE_HOST,
// never shown) and the buttons.

IDD_CONFIGURE DIALOGEX 0, 0, 300, 270
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Better Tabs"
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    CONTROL         "",IDC_TABS,"SysTabControl32",WS_CLIPSIBLINGS | WS_TABSTOP,7,7,286,17
    LTEXT           "",IDC_PAGE_HOST,0,28,300,218,NOT WS_VISIBLE
    PUSHBUTTON      "Defaults",IDC_DEFAULTS,7,250,50,14
    DEFPUSHBUTTON   "OK",IDOK,189,250,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,243,250,50,14
END

// Pages: child dialogs, 300 x 218, created once and shown one at a time. Keep the ids
// consecutive and in tab order.

IDD_PAGE_STRIP DIALOGEX 0, 0, 300, 218
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Strip",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Position:",IDC_STATIC,12,23,84,8
    COMBOBOX        IDC_POSITION,99,21,130,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Strip thickness:",IDC_STATIC,12,39,84,8
    EDITTEXT        IDC_THICKNESS,99,37,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "DIPs, 0 follows the font (0-200)",IDC_STATIC,131,39,162,8
    CONTROL         "Rotate the text on side strips",IDC_ROTATE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,53,281,10

    LTEXT           "Tabs",IDC_STATIC,7,75,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,85,286,1
    LTEXT           "Tab width:",IDC_STATIC,12,94,84,8
    COMBOBOX        IDC_SIZING,99,92,130,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Alignment:",IDC_STATIC,12,110,84,8
    COMBOBOX        IDC_ALIGN,99,108,130,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Overflow chevron:",IDC_STATIC,12,126,84,8
    COMBOBOX        IDC_CHEVRON,99,124,130,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Shorten titles to fit before showing the chevron",IDC_SHRINK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,140,281,10
    LTEXT           "Longest title:",IDC_STATIC,12,156,84,8
    EDITTEXT        IDC_MAX_WIDTH,99,154,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "DIPs, then cut with an ellipsis (0 = no limit)",IDC_STATIC,131,156,162,8
    LTEXT           "Padding across:",IDC_STATIC,12,172,84,8
    EDITTEXT        IDC_PAD_X,99,170,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "DIPs on each side of the title (0-64)",IDC_STATIC,131,172,162,8
    LTEXT           "Padding along:",IDC_STATIC,12,188,84,8
    EDITTEXT        IDC_PAD_Y,99,186,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "DIPs above and below the title (0-64)",IDC_STATIC,131,188,162,8
    LTEXT           "Spacing:",IDC_STATIC,12,204,84,8
    EDITTEXT        IDC_SPACING,99,202,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "DIPs between tabs (0-64)",IDC_STATIC,131,204,162,8
END

IDD_PAGE_LOOK DIALOGEX 0, 0, 300, 218
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Active tab",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Indicator:",IDC_STATIC,12,23,84,8
    COMBOBOX        IDC_INDICATOR,99,21,130,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Line width:",IDC_STATIC,12,39,84,8
    EDITTEXT        IDC_LINE_WIDTH,99,37,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "DIPs (0 = automatic, 1-8)",IDC_STATIC,131,39,162,8
    LTEXT           "Fill strength:",IDC_STATIC,12,55,84,8
    CONTROL         "Automatic",IDC_STRENGTH_AUTO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,99,54,52,10
    CONTROL         "",IDC_STRENGTH,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | WS_TABSTOP,153,52,108,14
    LTEXT           "",IDC_STRENGTH_VALUE,265,55,28,8

    LTEXT           "Every tab",IDC_STATIC,7,76,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,86,286,1
    CONTROL         "Show every tab as a chip",IDC_CHIP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,93,281,10
    LTEXT           "Corner radius:",IDC_STATIC,12,109,84,8
    EDITTEXT        IDC_RADIUS,99,107,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "DIPs (0-32)",IDC_STATIC,131,109,162,8
    LTEXT           "The hovered tab's look is on the Hover page, the colours on the Colours page.",IDC_STATIC,12,125,281,8
END

IDD_PAGE_HOVER DIALOGEX 0, 0, 300, 218
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Hovered tab",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Settings for:",IDC_STATIC,12,22,84,8
    COMBOBOX        IDC_HOVER_TARGET,99,20,130,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Style:",IDC_STATIC,12,37,84,8
    COMBOBOX        IDC_HOVER_STYLE,99,35,130,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Colour:",IDC_STATIC,12,53,84,8
    COMBOBOX        IDC_HOVER_COLOUR,99,51,130,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Custom colour:",IDC_STATIC,12,69,84,8
    EDITTEXT        IDC_HOVER_HEX,99,67,40,12,ES_AUTOHSCROLL | ES_UPPERCASE
    CONTROL         "",IDC_HOVER_SWATCH,"Button",BS_OWNERDRAW | WS_TABSTOP,143,67,24,12
    LTEXT           "RRGGBB",IDC_STATIC,171,69,122,8
    LTEXT           "Title:",IDC_STATIC,12,85,84,8
    COMBOBOX        IDC_HOVER_TEXT,99,83,130,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Lighten the text colour (white stays white)",IDC_HOVER_LIGHTEN,"Button",BS_AUTOCHECKBOX | NOT WS_VISIBLE | WS_TABSTOP,99,84,194,10

    LTEXT           "Fill and line",IDC_STATIC,7,106,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,116,286,1
    LTEXT           "Fill strength:",IDC_STATIC,12,125,84,8
    CONTROL         "Automatic",IDC_HOVER_FILL_AUTO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,99,124,52,10
    CONTROL         "",IDC_HOVER_FILL,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | WS_TABSTOP,153,122,108,14
    LTEXT           "",IDC_HOVER_FILL_VALUE,265,125,28,8
    LTEXT           "Line width:",IDC_STATIC,12,141,84,8
    EDITTEXT        IDC_HOVER_LINE_WIDTH,99,139,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "DIPs (0 = automatic, 1-8)",IDC_STATIC,131,141,162,8
    LTEXT           "Line opacity:",IDC_STATIC,12,157,84,8
    CONTROL         "Automatic",IDC_HOVER_LINE_AUTO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,99,156,52,10
    CONTROL         "",IDC_HOVER_LINE,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | WS_TABSTOP,153,154,108,14
    LTEXT           "",IDC_HOVER_LINE_VALUE,265,157,28,8

    LTEXT           "Animation",IDC_STATIC,7,178,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,188,286,1
    CONTROL         "Fade in and out",IDC_HOVER_FADE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,196,84,10
    EDITTEXT        IDC_HOVER_FADE_MS,99,195,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "ms (50-1000)",IDC_STATIC,131,197,162,8
END

IDD_PAGE_COLOURS DIALOGEX 0, 0, 300, 218
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Accent",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Accent colour:",IDC_STATIC,12,23,84,8
    COMBOBOX        IDC_ACCENT_SOURCE,99,21,130,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Custom accent:",IDC_STATIC,12,39,84,8
    EDITTEXT        IDC_ACCENT_HEX,99,37,40,12,ES_AUTOHSCROLL | ES_UPPERCASE
    CONTROL         "",IDC_ACCENT_SWATCH,"Button",BS_OWNERDRAW | WS_TABSTOP,143,37,24,12
    LTEXT           "RRGGBB",IDC_STATIC,171,39,122,8
    LTEXT           "Marks the active tab, selected tabs and, if chosen, the hovered tab. Kept legible against the strip.",IDC_STATIC,12,53,281,16

    LTEXT           "Strip background",IDC_STATIC,7,81,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,91,286,1
    LTEXT           "Background:",IDC_STATIC,12,100,84,8
    COMBOBOX        IDC_BACKGROUND,99,98,130,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Custom background:",IDC_STATIC,12,116,84,8
    EDITTEXT        IDC_BACKGROUND_HEX,99,114,40,12,ES_AUTOHSCROLL | ES_UPPERCASE
    CONTROL         "",IDC_BACKGROUND_SWATCH,"Button",BS_OWNERDRAW | WS_TABSTOP,143,114,24,12
    LTEXT           "RRGGBB",IDC_STATIC,171,116,122,8
    LTEXT           "Tint strength:",IDC_STATIC,12,132,84,8
    CONTROL         "",IDC_TINT,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | WS_TABSTOP,99,129,162,14
    LTEXT           "",IDC_TINT_VALUE,265,132,28,8
    CONTROL         "Transparent background",IDC_TRANSPARENT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,148,281,10
    LTEXT           "Shows what the layout paints behind the strip, such as a Columns UI theme's background image; tabs keep their fills. In a plain layout it looks the same. Not while auto-hide shows the strip over the panel.",IDC_STATIC,12,162,281,24
END

IDD_PAGE_FONTS DIALOGEX 0, 0, 300, 218
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Fonts",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Tab font:",IDC_STATIC,12,23,70,8
    LTEXT           "",IDC_FONT_TEXT,85,23,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",IDC_FONT_PICK,197,20,46,14
    PUSHBUTTON      "Default",IDC_FONT_CLEAR,247,20,46,14
    LTEXT           "Default follows the Columns UI font for these tabs (Colours and fonts), or the Default UI tab font. Picked sizes are exact; tab icons keep their icon font.",IDC_STATIC,12,38,281,16

    LTEXT           "Fallback fonts",IDC_STATIC,7,66,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,76,286,1
    LTEXT           "Fallback 1:",IDC_STATIC,12,85,70,8
    LTEXT           "",IDC_FALLBACK_TEXT,85,85,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",IDC_FALLBACK_PICK,197,82,46,14
    PUSHBUTTON      "Clear",IDC_FALLBACK_CLEAR,247,82,46,14
    LTEXT           "Fallback 2:",IDC_STATIC,12,103,70,8
    LTEXT           "",1204,85,103,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",1207,197,100,46,14
    PUSHBUTTON      "Clear",1210,247,100,46,14
    LTEXT           "Fallback 3:",IDC_STATIC,12,121,70,8
    LTEXT           "",1205,85,121,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",1208,197,118,46,14
    PUSHBUTTON      "Clear",1211,247,118,46,14
    LTEXT           "Tried in this order for characters the tab font cannot draw. Only the family is used: size, weight and italic follow the tab font. The host's own fallbacks (emoji, then Windows') come after these.",IDC_STATIC,12,136,281,24
END

IDD_PAGE_TABS DIALOGEX 0, 0, 300, 218
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
