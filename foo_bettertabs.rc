    EDITTEXT        IDC_AH_HOT_ZONE,99,108,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "DIPs along the edge that reveal the strip (1-32)",IDC_STATIC,131,110,162,8
