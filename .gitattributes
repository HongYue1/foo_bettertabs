# Git's autocrlf is on for this machine, which would rewrite these files on the
# next checkout. Pin line endings instead so diffs stay meaningful.
* text=auto eol=lf

# MSBuild and Windows tooling expect CRLF here.
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.sln text eol=crlf
*.bat text eol=crlf
*.rc text eol=crlf

*.png binary
